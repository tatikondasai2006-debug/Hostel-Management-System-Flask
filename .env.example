# ---------------------------------------------------------------------------
# Hostel Management System - example environment file
# Copy this file to ".env" and fill in real values.  NEVER commit ".env".
# ---------------------------------------------------------------------------

# Flask environment: development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key used to sign sessions and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection used by the running application.
DATABASE_URL=postgresql+psycopg2://hostel_user:hostel_pass@127.0.0.1:5432/hostel_db

# Separate PostgreSQL database used ONLY by the pytest suite (integration +
# concurrency tests).  It is created/dropped by the tests, so point it at a
# throw-away database.  Leave empty to skip PostgreSQL-only tests.
TEST_DATABASE_URL=postgresql+psycopg2://hostel_user:hostel_pass@127.0.0.1:5432/hostel_test

# SQLite fallback for quick local smoke runs (only used if DATABASE_URL is
# unset).  Do NOT use SQLite as the production database.
SQLITE_FALLBACK_URL=sqlite:///hostel_dev.sqlite3

# ---------------------------------------------------------------------------
# Initial administrator bootstrap (used by: flask bootstrap-admin)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@hostel.example
ADMIN_PASSWORD=ChangeThisAdminPassword!23
ADMIN_NAME=System Administrator

# ---------------------------------------------------------------------------
# Hostel identity (printed on PDF receipts / reports)
# Values below act as defaults; administrators can override them at runtime
# from the "Settings" page (persisted in the database).
# ---------------------------------------------------------------------------
HOSTEL_NAME=Sunrise Student Hostel
HOSTEL_ADDRESS=123 Campus Road, Springfield
HOSTEL_CONTACT=+1 555 0100
HOSTEL_EMAIL=office@sunrise-hostel.example

# Currency symbol shown in the UI
CURRENCY_SYMBOL=₹

# ---------------------------------------------------------------------------
# Security / session
# ---------------------------------------------------------------------------
# Set to 1 ONLY when running behind HTTPS (makes cookies Secure + SameSite=None)
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_MINUTES=120

# Login / signup rate limiting (per remote address)
RATELIMIT_LOGIN=10 per minute
RATELIMIT_SIGNUP=5 per hour

# Trust X-Forwarded-* headers (enable when behind Nginx/reverse proxy)
TRUST_PROXY=0
